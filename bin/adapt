#!/usr/bin/env bash
# Wire a tenant's context repository to this protocol, and to whichever AI coding agents the
# machine has. Idempotent: running it twice changes nothing the second time.
#
#   bin/adapt                      wire the current directory
#   bin/adapt --into <dir>         wire that directory
#   bin/adapt --copy               copy the protocol in instead of symlinking it, for a machine
#                                  that will not follow symlinks or whose agent config is managed
#   bin/adapt --agent <name>       wire only these adapters, instead of the ones detected
#   bin/adapt --list               show which adapters exist and which this machine has
#
# What it installs, all of it skipped where it is already there:
#   <tenant>/protocol          this repository, symlinked (gitignored — a machine-local path)
#   <tenant>/AGENTS.md         the entry point every agent reads, if the tenant has none
#   <tenant>/.protocol/tenant  the denylist naming the tenants this repository is not
#                              (its untracked `.local` overlay is gitignored, never seeded)
#   <tenant>/.protocol/protocol-version
#                              which commit of this protocol installed the tenant, rewritten each run
#   <tenant>/.githooks/        the pre-commit shim, and core.hooksPath pointed at it
#   agent configuration        whatever each detected adapter installs — for Claude Code, one skill
#                              per doctrine file and the commands under adapters/claude-code/
#   ~/.pablo-protocol          the well-known path the shim falls back to
set -euo pipefail

PROTOCOL="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WELL_KNOWN="${PROTOCOL_DIR:-$HOME/.pablo-protocol}"
TENANT="$PWD"
MODE="link"
requested=()

while [ $# -gt 0 ]; do
  case "$1" in
    --into) TENANT="$2"; shift 2 ;;
    --copy) MODE=copy; shift ;;
    --agent) requested+=("$2"); shift 2 ;;
    --list)
      for dir in "$PROTOCOL"/adapters/*/; do
        name="$(basename "$dir")"
        if bash "$dir/detect.sh" >/dev/null 2>&1; then echo "$name (installed)"; else echo "$name"; fi
      done
      exit 0 ;;
    -h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *) echo "adapt: unknown argument: $1" >&2; exit 2 ;;
  esac
done

TENANT="$(cd "$TENANT" && pwd)"
[ "$TENANT" != "$PROTOCOL" ] || { echo "adapt: the protocol repository is not a tenant" >&2; exit 2; }

# shellcheck disable=SC1091
. "$PROTOCOL/bin/tenant.sh"

place() { # src dst — symlink or copy, whichever the run asked for, and never twice
  local src=$1 dst=$2
  if [ -e "$dst" ] || [ -L "$dst" ]; then say skip "${dst#"$TENANT"/}"; return; fi
  # -L, because --copy exists for a machine that will not follow a symlink: this repository holds one
  # of its own (the shim it ships is the shim it runs), and copying it as a link would hand that
  # machine the very thing it cannot read.
  if [ "$MODE" = copy ]; then cp -RL "$src" "$dst"; else ln -s "$src" "$dst"; fi
  say "$MODE" "${dst#"$TENANT"/}"
}

seed() { # path — the tenant-template's copy of it, if the tenant has none of its own
  local rel=$1
  if [ -e "$TENANT/$rel" ]; then say skip "$rel"; return; fi
  mkdir -p "$TENANT/$(dirname "$rel")"
  cp "$PROTOCOL/tenant-template/$rel" "$TENANT/$rel"
  say seed "$rel"
}

# Which commit of this protocol this run installed, written into the file the seed above leaves
# holding only its header.
#
# This is a receipt, not a pin. It answers one question — which protocol the files in this tenant
# came from — and it is rewritten on every run, because a receipt that states an install other than
# the last one is the drift it exists to report. What judges a commit is a separate question, asked
# live of `protocol/` by `bin/doctor`, because that symlink can be moved with no file here changing.
#
# The line is derived entirely from the checkout, so two runs from the same commit write the same
# bytes and a second run really does change nothing.
record() {
  local rel=.protocol/protocol-version ref sha when line head
  ref="$(git -C "$PROTOCOL" symbolic-ref --short -q HEAD 2>/dev/null)" || ref=""
  # Detached at a tag is how a consumer who pins one checks out, and the tag is the more useful name
  # for that commit than the branch it is not on.
  [ -n "$ref" ] || { ref="$(git -C "$PROTOCOL" describe --tags --exact-match 2>/dev/null)" || ref=""; }
  sha="$(git -C "$PROTOCOL" rev-parse --short HEAD 2>/dev/null)" || sha=""
  when="$(git -C "$PROTOCOL" log -1 --format=%as 2>/dev/null)" || when=""
  [ -n "$ref" ] || ref="$sha"
  # No history to read: an archive rather than a clone. Saying so beats writing a name that cannot be
  # checked, and `bin/doctor` reports it as a note rather than a fault for the same reason.
  if [ -z "$sha" ]; then line="unknown"; else line="$ref $sha $when"; fi
  # Rewrite, keeping the header the template carries: a file that appended one line per run would
  # answer the question with a history nobody asked for, and the first line is what every reader takes.
  head="$(sed '/^[[:space:]]*[^#[:space:]]/d' "$TENANT/$rel")"
  if [ -n "$head" ]; then printf '%s\n%s\n' "$head" "$line" >"$TENANT/$rel"
  else printf '%s\n' "$line" >"$TENANT/$rel"; fi
  say record "$line"
}

echo "protocol: $PROTOCOL"
echo "tenant:   $TENANT"

# Not ${1/#"$HOME"/'~'}: an unquoted ~ in the replacement half is tilde-expanded straight back to
# $HOME, and quoting it works only from bash 4 on — 3.2, which is what macOS ships as
# /bin/bash, keeps the quotes and prints '~'/.pablo-protocol. `case` reads the same to every
# version, and a tenant is installed with whichever bash the machine has.
short() { case "$1" in "$HOME"|"$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

# The well-known path is what a repository's pre-commit shim falls back to, so the shim never has to
# carry a machine-local path. Left alone if it already points somewhere — that is someone's choice.
if [ -e "$WELL_KNOWN" ] || [ -L "$WELL_KNOWN" ]; then
  say skip "$(short "$WELL_KNOWN")"
else
  ln -s "$PROTOCOL" "$WELL_KNOWN"; say link "$(short "$WELL_KNOWN")"
fi

place "$PROTOCOL" "$TENANT/protocol"
# A copy is not a checkout. Carrying the protocol's own `.git` in would have git answer about the
# repository the copy was taken from — so the copy would report whatever that repository is at now,
# which is worse than reporting nothing, and it is `bin/doctor` that then has no way to say so.
if [ "$MODE" = copy ] && [ ! -L "$TENANT/protocol" ] && [ -e "$TENANT/protocol/.git" ]; then
  rm -rf "$TENANT/protocol/.git"
  say strip "protocol/.git"
fi
# `/protocol` is a machine-local path. The second is the untracked half of every policy file
# (§3): the terms a tenant must enforce but must not publish, ignored before one can exist,
# because the first `git add -A` after writing one is exactly the mistake the overlay was
# introduced to make impossible.
ignore "/protocol" "/.protocol/*.local"
seed AGENTS.md
seed .protocol/tenant
seed .protocol/protocol-version
record
seed .githooks/pre-commit
chmod +x "$TENANT/.githooks/pre-commit"

# `.git` is a file, not a directory, in a worktree and in a submodule. Testing for a directory left
# the hook installed and never pointed at, and said nothing about it.
if [ -e "$TENANT/.git" ] && [ "$(git -C "$TENANT" config --get core.hooksPath || true)" != ".githooks" ]; then
  git -C "$TENANT" config core.hooksPath .githooks
  say config "core.hooksPath=.githooks"
fi

adapters=()
if [ ${#requested[@]} -gt 0 ]; then
  adapters=("${requested[@]}")
else
  for dir in "$PROTOCOL"/adapters/*/; do
    bash "$dir/detect.sh" >/dev/null 2>&1 && adapters+=("$(basename "$dir")")
  done
fi

for name in "${adapters[@]}"; do
  [ -x "$PROTOCOL/adapters/$name/adapt.sh" ] || { echo "adapt: no such adapter: $name" >&2; exit 2; }
  echo "adapter:  $name"
  "$PROTOCOL/adapters/$name/adapt.sh" "$TENANT" "$MODE"
done
[ ${#adapters[@]} -gt 0 ] || echo "adapter:  none detected — AGENTS.md alone already carries the protocol"
