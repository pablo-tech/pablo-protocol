#!/usr/bin/env bash
# What a tenant can check about its own wiring, written once here rather than once per tenant.
#
#   bin/doctor                  check the current directory
#   bin/doctor --in <dir>       check that directory
#
# Four questions, each of which has a silent wrong answer:
#   the protocol   `protocol/` is a symlink, so the checkout behind it can move with no file here
#                  changing — and a tenant that tracks a branch can also simply be behind it
#   the links      a skill whose target has moved still lists, and fails only when something reads it
#   the hook       core.hooksPath does not travel with a clone, so a fresh clone runs no guards
#   the tenancy    a denylist that parses to zero terms polices nothing and says nothing about it
#
# And two that are notes rather than faults, because neither breaks anything today: a protocol that
# has moved on since `bin/adapt` last ran here, and a file the installer writes whole and then skips
# forever, still carrying what an older version of this protocol wrote.
#
# Exit 1 if anything is wrong. Nothing here prints a policy file's contents: a denylist read
# backwards is a list of what the repository is protecting, so the terms are counted, never named.
set -uo pipefail

PROTOCOL="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TENANT="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    --in) TENANT="$2"; shift 2 ;;
    -h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *) echo "doctor: unknown argument: $1" >&2; exit 2 ;;
  esac
done
TENANT="$(cd "$TENANT" && pwd)" || exit 2

fail=0
ok()   { printf "  ok    %s\n" "$1"; }
bad()  { printf "  MISS  %s%s\n" "$1" "${2:+  — $2}"; fail=$((fail+1)); }
note() { printf "  note  %s%s\n" "$1" "${2:+  — $2}"; }

echo "tenant:   $TENANT"

# 1. The protocol. `.protocol/protocol-version` is the receipt `bin/adapt` wrote: which commit of the
# protocol the files in this tenant came from. Which protocol judges a commit is a different
# question — decided live by the `protocol/` symlink, at the moment of the commit — so the two are
# asked separately rather than through one number that can only ever answer the second.
P="$TENANT/protocol"
V="$TENANT/.protocol/protocol-version"
read -r ref sha _rest <<<"$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$V" 2>/dev/null | head -1)"
if [ ! -d "$P/doctrine" ]; then
  bad "protocol/ does not resolve to a protocol checkout" "run this repository's bin/adapt from the protocol"
elif [ -z "$ref" ]; then
  bad "no protocol recorded" "run the protocol's bin/adapt from here — it writes .protocol/protocol-version"
elif [ "$ref" = unknown ]; then
  # `bin/adapt` writes this when it is run from a checkout with no history to read. It is a note for
  # the same reason it was written: nothing is wrong, and there is nothing here to check against.
  note "protocol recorded as unknown" "bin/adapt ran from a protocol with no history"
elif [ ! -e "$P/.git" ]; then
  # `bin/adapt --copy` leaves a directory with no history, which nothing can date. Say so once rather
  # than reporting every question below as unanswered on a machine that needed the copy.
  note "protocol is a copy, not a clone" "what $ref is now cannot be read from here"
elif git -C "$P" rev-parse --verify -q "refs/heads/$ref" >/dev/null; then
  # A branch: the tenant tracks it, and the question is whether this checkout is on it and level with
  # what the last fetch left at origin. Nothing here reaches the network — a check that does is a
  # check that fails on a plane, and it would be answering a question nobody asked at commit time.
  on="$(git -C "$P" symbolic-ref --short -q HEAD)" || on=""
  if [ -z "$on" ]; then
    bad "protocol is detached, recorded on $ref" "git -C \"$P\" checkout $ref"
  elif [ "$on" != "$ref" ]; then
    bad "protocol is on $on, recorded on $ref" "git -C \"$P\" checkout $ref"
  elif ! git -C "$P" rev-parse --verify -q "refs/remotes/origin/$ref" >/dev/null; then
    note "protocol on $ref, with no origin/$ref to compare against" "git -C \"$P\" fetch"
  else
    behind="$(git -C "$P" rev-list --count "HEAD..origin/$ref" 2>/dev/null || echo 0)"
    if [ "$behind" -gt 0 ]; then
      note "protocol is $behind commit(s) behind origin/$ref" "git -C \"$P\" pull --ff-only"
    else
      ok "protocol tracking $ref, current"
      # Current with what, though: origin/$ref is whatever the last fetch left behind. A tip that has
      # not moved in a fortnight is either a quiet protocol or a stale fetch, and from here those two
      # look identical — so the age is reported rather than silently read as the first.
      tip="$(git -C "$P" log -1 --format=%ct "origin/$ref" 2>/dev/null)" || tip=""
      if [ -n "$tip" ]; then
        age=$(( ( $(date +%s) - tip ) / 86400 ))
        [ "$age" -lt 14 ] || note "origin/$ref has not moved in $age days" "git -C \"$P\" fetch, if that is not what you expect"
      fi
    fi
  fi
elif ! git -C "$P" rev-parse --verify -q "refs/tags/$ref" >/dev/null &&
     at="$(git -C "$P" rev-parse -q --verify "$ref^{commit}" 2>/dev/null)"; then
  # A bare commit, which is what `bin/adapt` records when it is run out of a checkout that is on no
  # branch and at no tag — a CI runner's, most often. There is nothing to be behind, so the only
  # question left is whether the checkout is still the one the receipt names.
  if [ "$at" = "$(git -C "$P" rev-parse HEAD)" ]; then ok "protocol at $ref, on no branch"
  else bad "protocol has moved off the commit recorded here" "git -C \"$P\" checkout $ref"; fi
else
  # A tag, or a name this checkout no longer has. A tenant may still pin deliberately — the protocol
  # keeps cutting tags for breaking changes — and the check a pin wants is the one made here all along.
  have="$(git -C "$P" describe --tags --exact-match 2>/dev/null)"
  if [ "$have" = "$ref" ]; then ok "protocol pinned at $ref"
  elif [ -z "$have" ]; then
    bad "protocol is not at a tag, pinned to $ref" "git -C \"$P\" fetch --tags && git -C \"$P\" checkout $ref"
  else
    bad "protocol is at $have, pinned to $ref" "git -C \"$P\" checkout $ref"
  fi
fi

# The other half of the receipt, and the reason it records a commit and not just a branch: the files
# installed here — the shim, the seeded policy files, the adapter launchers — came from one commit,
# and the checkout has moved since. Nothing is broken, because `protocol/` is what judges a commit
# and it is current; what is stale is everything `bin/adapt` copied in and now skips forever.
if [ -n "$sha" ] && [ -d "$P/doctrine" ] && [ -e "$P/.git" ]; then
  at="$(git -C "$P" rev-parse -q --verify "$sha^{commit}" 2>/dev/null)" || at=""
  now="$(git -C "$P" rev-parse HEAD 2>/dev/null)" || now=""
  if [ -z "$at" ]; then
    note "the commit bin/adapt recorded ($sha) is not in this checkout" "git -C \"$P\" fetch, then re-run bin/adapt from here"
  elif [ "$at" != "$now" ]; then
    note "protocol has moved since bin/adapt last ran here" "re-run the protocol's bin/adapt from here"
  fi
fi

# 2. The links. Every adapter installs symlinks into `protocol/`, and one whose target has moved
# still lists — it fails only when something tries to read it. Tracked links only: those are the ones
# that travel to another machine, where an untracked dangling link is that machine's own business.
dead=""
while IFS= read -r rel; do
  [ -e "$TENANT/$rel" ] || dead="$dead $rel"
done < <(git -C "$TENANT" ls-files -s 2>/dev/null | awk '$1 == 120000 {sub(/^[^\t]*\t/, ""); print}')
if [ -z "$dead" ]; then ok "every tracked link resolves"
else bad "links pointing at nothing:$dead" "re-run the protocol's bin/adapt, or remove them"; fi

# 3. The hook. `core.hooksPath` is local configuration: a clone carries the shim and runs none of it
# until something points git at the directory holding it.
if [ ! -e "$TENANT/.git" ]; then
  note "not a git repository" "the guards run at commit time and there are no commits here"
elif [ "$(git -C "$TENANT" config --get core.hooksPath 2>/dev/null || true)" = ".githooks" ]; then
  ok "core.hooksPath=.githooks"
else
  bad "core.hooksPath is not .githooks" "git -C \"$TENANT\" config core.hooksPath .githooks"
fi

# The shim decides which checkout of the protocol the guards come from, and a tenant carrying one
# from before this step existed reads its doctrine from one checkout and runs its guards from
# another — the well-known path, which is one per machine, where a tenant's own `protocol/` is one
# per repository and is the checkout the rest of this file has just reported on.
#
# Asked only of a shim that came from `tenant-template/`, which every version of it has named
# `PROTOCOL_GUARDS` in. A tenant that wrote its own shim resolves the guards its own way — through a
# dispatcher of its own, most likely, which this cannot read out of the file. Asserting anyway would
# report a fault against a repository that is wired correctly, and a check that does that is one
# people learn to scroll past.
#
# The remedy is not "re-run bin/adapt": the installer seeds this file and then never rewrites it,
# which is what makes it the tenant's to edit. Copying over it is a decision, so it is stated as one.
if [ -x "$P/guards/guards.sh" ] && [ -f "$TENANT/.githooks/pre-commit" ] &&
   grep -q 'PROTOCOL_GUARDS' "$TENANT/.githooks/pre-commit" &&
   ! grep -q 'protocol/guards' "$TENANT/.githooks/pre-commit"; then
  bad ".githooks/pre-commit never consults this repository's own protocol/" \
      "cp protocol/tenant-template/.githooks/pre-commit .githooks/pre-commit (bin/adapt will not)"
fi

# A launcher is not a seed: the tenant does not own it, the adapter writes it whole, and `bin/adapt`
# skips it forever after because it exists. So a tenant installed before the adapter changed keeps
# the old one with nothing to see — the drift the receipt above reports, one directory down, for the
# one file the receipt cannot speak for because no seed ever wrote it.
while IFS= read -r src; do
  agent="$(basename "$(dirname "$src")")"
  dst="$TENANT/.agents/$agent/run"
  [ -f "$dst" ] || continue
  cmp -s "$src" "$dst" && continue
  note ".agents/$agent/run differs from the one this protocol installs" \
       "cp protocol/adapters/$agent/run .agents/$agent/run, or keep yours deliberately"
done < <(find "$P/adapters" -mindepth 2 -maxdepth 2 -name run -type f 2>/dev/null | sort)

# 4. The tenancy. The count, and only the count. Read through the guards' own policy parser, so
# what is counted here is what a guard would see rather than a second reading of the same file.
if [ ! -e "$TENANT/.git" ]; then
  note "tenancy not read" "policy files are resolved from a repository root"
elif terms="$(cd "$TENANT" && . "$PROTOCOL/guards/policy.sh" && policy tenant)"; then
  n="$(printf '%s' "$terms" | grep -c . || true)"
  if [ "$n" -gt 0 ]; then ok "tenancy declared: $n term(s)"
  else note "tenancy declares 0 terms" "the guard exits 0 — .protocol/tenant polices nothing yet"; fi
else
  note "no .protocol/tenant" "this repository declares no tenancy and is not policed"
fi

[ "$fail" -eq 0 ] || echo "doctor: $fail problem(s)"
exit $(( fail > 0 ))
